# ===== ViPost local =====
# Địa chỉ app khi chạy trên máy
APP_URL=http://localhost:3000

# Mật khẩu vào app (bắt buộc nên đặt, nhất là khi mở tunnel ra ngoài). Đăng nhập: user bất kỳ + mật khẩu này
APP_PASSWORD=doi-mat-khau-nay

# Khoá mã hoá token (64 ký tự hex). Tạo bằng:  openssl rand -hex 32
ENCRYPTION_KEY=

DATABASE_URL="file:./vipost.db?connection_limit=1&socket_timeout=10"
UPLOAD_DIR=./uploads

# Bật kênh "Demo" để thử app khi chưa có khoá TikTok/YouTube (1 = bật)
DEMO_MODE=1

# ===== TikTok (developers.tiktok.com) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok bắt buộc redirect https. Đặt bằng địa chỉ trang tiktok-redirect/index.html bạn host (vd GitHub Pages)
# hoặc địa chỉ tunnel https: https://xxx.trycloudflare.com/api/auth/tiktok/callback
TIKTOK_REDIRECT_URI=

# ===== YouTube (console.cloud.google.com) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect cần khai báo trong Google Cloud: http://localhost:3000/api/auth/youtube/callback
